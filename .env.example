# Copie para .env e preencha. O .env não vai para o controle de versão.
# Sem usuário/senha o script funciona igual — apenas sempre pelo login manual.
TECFISCAL_USUARIO=
TECFISCAL_SENHA=

# Opcional: CNPJ da filial a selecionar após o login.
# Vazio = mantém a filial que o portal já traz.
TECFISCAL_CNPJ=
